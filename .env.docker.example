# Used by: docker compose --env-file .env.docker up -d --build
# Copy to .env.docker and replace every value marked CHANGE-ME.

# Docker Hub mirror prefix for Iran (leave empty if Docker Hub is reachable), e.g. docker.arvancloud.ir/
REGISTRY=

POSTGRES_USER=booking
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=booking

# At least 32 random characters, e.g. output of: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=CHANGE-ME

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-strong-admin-password
ADMIN_FULL_NAME=مدیر سامانه

SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=CHANGE-ME
KAVENEGAR_TEMPLATE=verify

# true behind HTTPS (recommended). Set false only when testing over plain http://localhost
COOKIE_SECURE=true
APP_PORT=3000
