{
  "name": "appointment-booking",
  "version": "1.0.0",
  "private": true,
  "description": "سامانه رزرو آنلاین جلسات مشاوره با پنل مدیریت",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db": "node scripts/db.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx prisma/seed.ts --demo",
    "setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "tsx tests/e2e/run.ts"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@hookform/resolvers": "5.9.2",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@tanstack/react-query": "5.104.5",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "jalaali-js": "1.2.8",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-hook-form": "7.90.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.1.18",
    "@types/jalaali-js": "1.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "playwright-core": "1.56.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
