# ---------------------------------------------------------------
# پایگاه داده
# اجرای محلی با `npm run db` (PostgreSQL داخلی روی پورت 5433)
# اجرای با Docker Compose: این مقدار در docker-compose.yml بازنویسی می‌شود
# ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/booking?schema=public"
# دیتابیس جداگانه برای تست‌های یکپارچه (هر بار پاک‌سازی می‌شود)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/booking_test?schema=public"

# کلید مخفی برای هش کدهای OTP (حداقل ۳۲ کاراکتر تصادفی)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# حساب مدیر اولیه (توسط npm run db:seed ساخته/به‌روزرسانی می‌شود)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="Admin@12345"
ADMIN_FULL_NAME="مدیر سامانه"

# ---------------------------------------------------------------
# سرویس پیامک
# console  : فقط در محیط توسعه؛ کد در ترمینال چاپ و در صفحه نمایش داده می‌شود
# kavenegar: ارسال واقعی با کاوه‌نگار (متد verify/lookup)
# در Production استفاده از console مجاز نیست و ارسال کد خطا می‌دهد.
# ---------------------------------------------------------------
SMS_PROVIDER="console"
KAVENEGAR_API_KEY=""
KAVENEGAR_TEMPLATE="verify"

# اگر پشت HTTPS نیستید (مثلاً اجرای Docker روی localhost) مقدار false بگذارید
COOKIE_SECURE="false"
